theme = dark:Catppuccin Mocha,light:Catppuccin Latte
# This automatically attaches to tmux if it's the first Ghostty terminal. Any
# subsequent Ghostty instance won't attach automatically.
# Launch inside zsh to ensure PATH is set up correctly and tmux can be found on
# both macOS and Linux
initial-command = zsh -c 'tmux new-session -A'

# I use the option key to switch tmux panes so it needs to be treated as an alt
# key. Without this option pressing the navigation shortcut for tmux instead
# prints some Unicode character.
# Only enabling this for the left key because that's the only one I use at the
# moment.
macos-option-as-alt = left

# Default size is 13, but that tends to cut off the neovim 80 character bar,
# giving just not enough space for a full line when working with split panes.
# Scaling it down to 12 tends to leave enough room.
font-size = 12

maximize
# See https://ghostty.org/docs/help/terminfo#ssh
shell-integration-features = ssh-terminfo,ssh-env

# Ghostty directly opens tmux which saves its session. Closing Ghotty is not a
# destructive operation so we don't need to confirm if it's okay to close.
confirm-close-surface = false
